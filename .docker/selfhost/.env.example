# select a revision to deploy, available values: stable, beta, canary
NEXIO_REVISION=stable

# set the port for the server container it will expose the server on
PORT=3010

# set the host for the server for outgoing links
# nexio_SERVER_HTTPS=true
# nexio_SERVER_HOST=nexio.yourdomain.com
# or 
# nexio_SERVER_EXTERNAL_URL=https://nexio.yourdomain.com

# position of the database data to persist
DB_DATA_LOCATION=~/.nexio/self-host/postgres/pgdata
# position of the upload data(images, files, etc.) to persist
UPLOAD_LOCATION=~/.nexio/self-host/storage
# position of the configuration files to persist
CONFIG_LOCATION=~/.nexio/self-host/config

# database credentials
DB_USERNAME=nexio
DB_PASSWORD=
DB_DATABASE=nexio