{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch NEXIO Cloud",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@affine/server",
        "dev"
      ]
    },
    {
      "name": "Lanuch NEXIO Web",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "yarn",
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "affine",
        "@affine/web",
        "dev"
      ]
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug NEXIO Web",
      "url": "http://localhost:8080"
    }
  ]
}